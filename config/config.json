{
    "app_name": "Face Detection Attendance System",
    "theme": "default",
    "log_level": "INFO",
    "camera": {
        "id": 0,
        "resolution": [
            1280,
            720
        ],
        "fps": 30,
        "device_id": 0,
        "flip_image": false,
        "auto_focus": true,
        "auto_exposure": true
    },
    "face_detection": {
        "confidence_threshold": 0,
        "recognition_buffer_size": 5,
        "min_recognized_frames": 3,
        "show_recognition_confidence": true,
        "show_bounding_box": true,
        "late_threshold_seconds": 300,
        "min_face_size": 30,
        "max_faces": 20,
        "processing_scale": 0.75,
        "stabilization": true,
        "stabilization_frames": 5
    },
    "attendance": {
        "default_subject": "CS101",
        "auto_backup": true,
        "attendance_directory": "Attendance"
    },
    "ui": {
        "font_family": "Helvetica",
        "title_font_size": 16,
        "normal_font_size": 12,
        "window_width": 1024,
        "window_height": 768,
        "fullscreen": false,
        "show_status_bar": true,
        "theme": "system",
        "font_size": "medium",
        "animations": true
    },
    "face_recognition": {
        "detection_model": "hog",
        "scale_factor": 0.5,
        "recognition_threshold": 0.6,
        "min_face_size": 30,
        "max_faces": 10,
        "stabilization_frames": 3
    },
    "video": {
        "width": 640,
        "height": 480,
        "fps": 30,
        "buffer_size": 3
    },
    "database": {
        "connection_pool_size": 10,
        "timeout": 30,
        "backup_enabled": true,
        "backup_interval_days": 7
    },
    "memory": {
        "performance_monitoring": false
    },
    "performance_profile": "high",
    "data_paths": {
        "attendance": "Attendance",
        "training_images": "TrainingImage",
        "student_details": "StudentDetails"
    },
    "advanced": {
        "debug_mode": false,
        "memory_management": "auto",
        "log_level": "info"
    }
}