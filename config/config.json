{
  "app": {
    "name": "Face Detection Attendance System",
    "version": "1.5.0"
  },
  "ui": {
    "type": "modern",
    "theme": "system",
    "color_theme": "blue",
    "font_size": "medium",
    "animations": true
  },
  "camera": {
    "device_id": 0,
    "id": 0,
    "resolution": {
      "width": 640,
      "height": 480
    },
    "fps": 30
  },
  "face_detection": {
    "detection_method": "yunet",
    "confidence_threshold": 0.9,
    "min_face_size": 20
  },
  "face_recognition": {
    "method": "sface",
    "threshold": 0.363,
    "multi_detection": true
  },
  "liveness": {
    "enabled": true,
    "threshold": 0.5,
    "window": 5,
    "required_live_frames": 3
  },
  "attendance": {
    "auto_export_csv": true,
    "duplicate_timeout": 600,
    "default_subject": "General"
  },
  "backup": {
    "auto_backup": true,
    "frequency_days": 7,
    "retention_days": 30
  },
  "training": {
    "max_images": 50,
    "interval": 0.5
  }
}
